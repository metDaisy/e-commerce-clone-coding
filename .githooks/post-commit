#!/usr/bin/env sh
# Re-index the committed checkout before returning from post-commit.
set -eu

repo_root=$(git rev-parse --show-toplevel)
head_sha=$(git rev-parse HEAD)
state_file=$(git rev-parse --git-path codebase-memory/last-indexed-head)
project_name=${CODEBASE_MEMORY_PROJECT_NAME:-C-Users-leee-IdeaProjects-e-commerce-clone-coding}

resolve_mcp_python() {
  if [ -n "${PYTHON:-}" ]; then
    if ! command -v "$PYTHON" >/dev/null 2>&1; then
      printf '%s\n' "post-commit: PYTHON=$PYTHON was not found; index is stale." >&2
      return 1
    fi
    if ! "$PYTHON" -c 'import mcp' >/dev/null 2>&1; then
      printf '%s\n' "post-commit: PYTHON=$PYTHON cannot import mcp; index is stale." >&2
      return 1
    fi
    printf '%s\n' "$PYTHON"
    return 0
  fi

  for candidate in \
    "${HERMES_MCP_PYTHON:-}" \
    "${LOCALAPPDATA:-}/hermes/hermes-agent/venv/Scripts/python.exe" \
    "$HOME/.hermes/hermes-agent/venv/bin/python" \
    python3 \
    python; do
    [ -n "$candidate" ] || continue
    if command -v "$candidate" >/dev/null 2>&1 \
      && "$candidate" -c 'import mcp' >/dev/null 2>&1; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  printf '%s\n' 'post-commit: no Python interpreter with the mcp SDK was found; set PYTHON or HERMES_MCP_PYTHON.' >&2
  return 1
}

if ! python_command=$(resolve_mcp_python); then
  exit 1
fi

mkdir -p "$(dirname "$state_file")"
printf '%s\n' "post-commit: indexing $head_sha" >&2

if "$python_command" "$repo_root/.githooks/index_codebase_memory.py" \
  --repo-root "$repo_root" \
  --project-name "$project_name"; then
  printf '%s\n' "$head_sha" >"$state_file"
  printf '%s\n' "post-commit: Codebase Memory is current at $head_sha" >&2
else
  rm -f "$state_file"
  printf '%s\n' 'post-commit: Codebase Memory indexing failed; do not treat this commit as checkpoint-ready.' >&2
  exit 1
fi