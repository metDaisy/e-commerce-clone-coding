<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="charset" value="UTF-8"/>

    <module name="TreeWalker">
        <module name="io.github.metdaisy.checkstyle.NoFullyQualifiedTypeCheck"/>
        <module name="io.github.metdaisy.checkstyle.NoReplacementCharacterCheck"/>
        <module name="io.github.metdaisy.checkstyle.SuspiciousKoreanEncodingCheck">
            <property name="severity" value="warning"/>
            <property name="whitelistFile" value="${config_loc}/whitelist.yml"/>
        </module>
    </module>
</module>
